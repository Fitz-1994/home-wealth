# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_pwd
MYSQL_USER=hwuser
MYSQL_PASSWORD=change_me_db_pwd

# JWT（至少32位随机字符串）
JWT_SECRET=change_me_to_a_very_long_random_secret_key_min_32_chars
# 登录过期时间（毫秒）；<= 0 表示永不过期（适合内网私有化部署）
JWT_EXPIRATION=0

# AI 视觉识别配置（用于持仓截图识别功能）
# provider: anthropic（默认）或 openai-compatible（MiniMax/OpenAI 等）
AI_PROVIDER=anthropic
AI_API_KEY=sk-ant-xxxx
# AI_API_URL=https://api.minimax.chat/v1/chat/completions   # openai-compatible 时填写
# AI_MODEL=MiniMax-M2.5                                      # openai-compatible 时填写

# 飞书自建应用推送（每日资产日报，从 auto-trade 迁移）
# 三个密钥从 auto-trade 的 quant-secrets/.env 拷贝：FEISHU_APP_ID / FEISHU_APP_SECRET / FEISHU_TARGET_CHAT_ID
FEISHU_ENABLED=false
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_TARGET_CHAT_ID=oc_xxx
# 提前退休年度分红目标（CNY），进度条基于滚动12月分红/该目标
FEISHU_RETIREMENT_TARGET=200000
# 推送时间（Spring cron，默认每日 09:00 Asia/Shanghai）
# FEISHU_DAILY_CRON=0 0 9 * * *
# 日报白名单用户 id（逗号分隔）；留空=所有活跃用户。例：只发 Fitz(id=1)
FEISHU_DIGEST_USER_IDS=1
